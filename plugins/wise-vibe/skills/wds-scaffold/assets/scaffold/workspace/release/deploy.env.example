# release/deploy.env — release/release.sh 기본값 (cp 후 편집; gitignore 대상).
# 비밀 없음: 모든 비밀번호·키는 대상 머신에서 scripts/prod-secrets.sh 가 생성한다.
# CLI 옵션이 우선하고, 빈 값은 질문(또는 --yes 면 기본값)으로 채운다.

# --- target ---
TARGET_ENV=dev
# SERVICES=all  (또는 release/services.tsv 의 short/repo 이름을 쉼표로)

# --- remote server (deploy / status / down --remote) ---
REMOTE_HOST=deploy@203.0.113.10
SSH_PORT=22
SSH_KEY=~/.ssh/id_ed25519
REMOTE_DIR=/opt/{{PROJECT_NAME}}
# local: 서버 CPU 아키텍처로 여기서 빌드해 이미지를 스트리밍 (서버에 레지스트리·PyPI·npm 접근 불필요)
# remote: 서버에서 빌드
BUILD_ON=local
